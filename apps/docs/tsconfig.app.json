{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"allowSyntheticDefaultImports": true,
		"outDir": "../../dist/out-tsc",
		"types": [
			"node"
		],
		"moduleResolution": "bundler"
	},
	"files": [
		"src/main.ts",
		"src/main.server.ts",
		"server.ts"
	],
	"include": [
		"src/**/*.d.ts"
	],
	"exclude": [
		"**/*.test.ts",
		"**/*.spec.ts"
	]
}
